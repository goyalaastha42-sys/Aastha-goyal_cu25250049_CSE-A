#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge {
    int u;
    int v;
    int weight;
};

int main() {
    int N, M, K;

    cin >> N >> M >> K;

    vector<Edge> edges(M);

    // Input edges
    for (int i = 0; i < M; i++) {
        cin >> edges[i].u
            >> edges[i].v
            >> edges[i].weight;
    }

    const int INF = INT_MAX / 2;

    // dist[v] = minimum cost to reach v
    // using the allowed number of edges
    vector<int> dist(N + 1, INF);

    dist[1] = 0;

    // Allow at most K edges
    for (int step = 1; step <= K; step++) {

        vector<int> newDist = dist;

        for (Edge e : edges) {

            // u -> v
            if (dist[e.u] + e.weight < newDist[e.v]) {
                newDist[e.v] = dist[e.u] + e.weight;
            }

            // v -> u because graph is undirected
            if (dist[e.v] + e.weight < newDist[e.u]) {
                newDist[e.u] = dist[e.v] + e.weight;
            }
        }

        dist = newDist;
    }

    if (dist[N] == INF) {
        cout << -1;
    }
    else {
        cout << "Minimum path weight = " << dist[N];
    }

    return 0;
}
