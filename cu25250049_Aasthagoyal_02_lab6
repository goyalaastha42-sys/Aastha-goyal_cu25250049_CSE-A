#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    vector<int> a = {-3, 1, 2, 5, 6, -3, 8, 1, 9, 2};

    sort(a.begin(), a.end());

    for (int i = 0; i < a.size() - 2; i++) {

        if (i > 0 && a[i] == a[i - 1])
            continue;

        int left = i + 1;
        int right = a.size() - 1;

        while (left < right) {
            int sum = a[i] + a[left] + a[right];

            if (sum == 0) {
                cout << a[i] << " " << a[left] << " " << a[right] << endl;

                left++;
                right--;

                while (left < right && a[left] == a[left - 1])
                    left++;

                while (left < right && a[right] == a[right + 1])
                    right--;
            }
            else if (sum < 0) {
                left++;
            }
            else {
                right--;
            }
        }
    }

    return 0;
}



